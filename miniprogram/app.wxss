/* 全局样式 */
page {
  background: #f1f5f9;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #0f172a;
  font-size: 28rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, .06);
}
.btn-primary {
  background: linear-gradient(135deg, #f43f5e, #fb923c);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
