.page { padding-bottom: 40rpx; }

.map {
  width: 100%;
  height: 640rpx;
}

/* 分类筛选条 */
.cat-bar {
  white-space: nowrap;
  padding: 20rpx 20rpx 0;
}
.cat-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 26rpx;
  color: #475569;
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,.05);
}
.cat-item.active {
  background: #0f172a;
  color: #fff;
}

/* 今天吃什么 */
.eat-card { text-align: center; }
.eat-title { font-weight: 700; margin-bottom: 18rpx; }
.eat-result {
  margin-top: 20rpx; font-size: 30rpx;
}
.eat-pick { color: #e11d48; font-weight: 700; font-size: 34rpx; }
.eat-tip { margin-top: 14rpx; font-size: 22rpx; color: #94a3b8; }
.btn-primary { width: 80%; }

/* 点位列表 */
.list-title { font-weight: 700; margin-bottom: 10rpx; }
.poi-item {
  display: flex; align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.poi-item:last-child { border-bottom: none; }
.poi-hover { background: #f8fafc; border-radius: 12rpx; }
.poi-icon { font-size: 40rpx; margin-right: 20rpx; }
.poi-body { flex: 1; }
.poi-name { font-weight: 600; }
.poi-desc { font-size: 24rpx; color: #64748b; margin-top: 4rpx; }
.poi-arrow { font-size: 24rpx; color: #e11d48; }
